{
  "name": "gleanery-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "gen:api": "openapi-typescript ../backend/openapi.json -o src/api/schema.d.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ai-sdk/react": "~4.0.163",
    "@assistant-ui/react": "~0.15.32",
    "@assistant-ui/react-ai-sdk": "~1.4.21",
    "@assistant-ui/react-markdown": "^0.14.24",
    "@tanstack/react-query": "~5.105.0",
    "@tanstack/react-router": "~1.170.46",
    "ai": "~7.0.159",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.65.0",
    "next-themes": "^0.4.6",
    "openapi-fetch": "~0.17.0",
    "radix-ui": "^1.8.1",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-shimmer": "^0.4.14",
    "zustand": "~5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "~1.64.1",
    "@tailwindcss/vite": "~4.3.3",
    "@tanstack/router-plugin": "~1.168.48",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "~16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "~6.1.2",
    "eslint": "~10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "~30.1.3",
    "msw": "~3.0.3",
    "openapi-typescript": "~7.13.0",
    "prettier": "~3.9.10",
    "tailwindcss": "~4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.72.1",
    "vite": "~8.3.5",
    "vitest": "~5.0.5"
